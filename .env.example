# Copy to .env (gitignored) and adjust per machine. Never commit .env.
# All variables are optional; defaults are the checked-in behavior.
# NOTE: shells, mise, and pnpm do NOT auto-load `.env` into process.env,
# so `vite.config.ts` only sees VITEST_WORKERS when it is exported in the
# calling environment (e.g. `export VITEST_WORKERS=8` or per-command
# `VITEST_WORKERS=8 pnpm test`).

# Parallel Vitest workers (default 2 keeps headroom for native compilation).
VITEST_WORKERS=2

# Override Cargo's target directory (e.g. tmpfs for speed or a per-host path).
# src-tauri/build.rs respects this when creating the pdf-helper placeholder.
# CARGO_TARGET_DIR=/tmp/babel-target
